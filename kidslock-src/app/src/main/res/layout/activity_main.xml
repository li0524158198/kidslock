<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/tv_margin_h"
        android:gravity="center_horizontal">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <!-- 版本号 -->
        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_medium" />

        <!-- 状态 -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_subtitle"
            android:layout_marginBottom="@dimen/spacing_small" />

        <TextView
            android:id="@+id/tvRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/highlight"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_large" />

        <!-- ===== 计时控制 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_timer"
            android:textColor="@color/highlight"
            android:textSize="@dimen/text_subtitle"
            android:layout_marginBottom="@dimen/spacing_small" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:layout_marginBottom="@dimen/spacing_medium">

            <Button
                android:id="@+id/btnStartTimer"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:text="@string/btn_start_timer"
                android:textSize="@dimen/text_button"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btnStopTimer"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:text="@string/btn_stop_timer"
                android:textSize="@dimen/text_button"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btnLockNow"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:text="@string/btn_lock_now"
                android:textSize="@dimen/text_button"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btnUnlock"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:text="@string/btn_unlock"
                android:textSize="@dimen/text_button"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
        </GridLayout>

          <!-- ===== 参数配置 ===== -->
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/section_config"
              android:textColor="@color/highlight"
              android:textSize="@dimen/text_subtitle"
              android:layout_marginTop="@dimen/spacing_large"
              android:layout_marginBottom="@dimen/spacing_small" />

          <!-- 题库选择：学科 × 年级（人教版 1-12 年级） -->
          <GridLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:columnCount="3">
              <Button android:id="@+id/subject0"
                  android:layout_width="0dp" android:layout_columnWeight="1"
                  android:layout_height="@dimen/btn_height" android:layout_margin="@dimen/btn_margin"
                  android:text="语文" android:textSize="@dimen/text_body"
                  android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                  android:focusable="true" android:clickable="true" />
              <Button android:id="@+id/subject1"
                  android:layout_width="0dp" android:layout_columnWeight="1"
                  android:layout_height="@dimen/btn_height" android:layout_margin="@dimen/btn_margin"
                  android:text="数学" android:textSize="@dimen/text_body"
                  android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                  android:focusable="true" android:clickable="true" />
              <Button android:id="@+id/subject2"
                  android:layout_width="0dp" android:layout_columnWeight="1"
                  android:layout_height="@dimen/btn_height" android:layout_margin="@dimen/btn_margin"
                  android:text="英语" android:textSize="@dimen/text_body"
                  android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                  android:focusable="true" android:clickable="true" />
          </GridLayout>

          <GridLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:columnCount="6">
              <Button android:id="@+id/grade0"
                  android:layout_width="0dp" android:layout_columnWeight="1"
                  android:layout_height="@dimen/btn_height" android:layout_margin="@dimen/btn_margin"
                  android:text="一" android:textSize="@dimen/text_body"
                  android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                  android:focusable="true" android:clickable="true" />
              <Button android:id="@+id/grade1"
                  android:layout_width="0dp" android:layout_columnWeight="1"
                  android:layout_height="@dimen/btn_height" android:layout_margin="@dimen/btn_margin"
                  android:text="二" android:textSize="@dimen/text_body"
                  android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                  android:focusable="true" android:clickable="true" />
              <Button android:id="@+id/grade2"
                  android:layout_width="0dp" android:layout_columnWeight="1"
                  android:layout_height="@dimen/btn_height" android:layout_margin="@dimen/btn_margin"
                  android:text="三" android:textSize="@dimen/text_body"
                  android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                  android:focusable="true" android:clickable="true" />
              <Button android:id="@+id/grade3"
                  android:layout_width="0dp" android:layout_columnWeight="1"
                  android:layout_height="@dimen/btn_height" android:layout_margin="@dimen/btn_margin"
                  android:text="四" android:textSize="@dimen/text_body"
                  android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                  android:focusable="true" android:clickable="true" />
              <Button android:id="@+id/grade4"
                  android:layout_width="0dp" android:layout_columnWeight="1"
                  android:layout_height="@dimen/btn_height" android:layout_margin="@dimen/btn_margin"
                  android:text="五" android:textSize="@dimen/text_body"
                  android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                  android:focusable="true" android:clickable="true" />
              <Button android:id="@+id/grade5"
                  android:layout_width="0dp" android:layout_columnWeight="1"
                  android:layout_height="@dimen/btn_height" android:layout_margin="@dimen/btn_margin"
                  android:text="六" android:textSize="@dimen/text_body"
                  android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                  android:focusable="true" android:clickable="true" />
              <Button android:id="@+id/grade6"
                  android:layout_width="0dp" android:layout_columnWeight="1"
                  android:layout_height="@dimen/btn_height" android:layout_margin="@dimen/btn_margin"
                  android:text="初一" android:textSize="@dimen/text_body"
                  android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                  android:focusable="true" android:clickable="true" />
              <Button android:id="@+id/grade7"
                  android:layout_width="0dp" android:layout_columnWeight="1"
                  android:layout_height="@dimen/btn_height" android:layout_margin="@dimen/btn_margin"
                  android:text="初二" android:textSize="@dimen/text_body"
                  android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                  android:focusable="true" android:clickable="true" />
              <Button android:id="@+id/grade8"
                  android:layout_width="0dp" android:layout_columnWeight="1"
                  android:layout_height="@dimen/btn_height" android:layout_margin="@dimen/btn_margin"
                  android:text="初三" android:textSize="@dimen/text_body"
                  android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                  android:focusable="true" android:clickable="true" />
              <Button android:id="@+id/grade9"
                  android:layout_width="0dp" android:layout_columnWeight="1"
                  android:layout_height="@dimen/btn_height" android:layout_margin="@dimen/btn_margin"
                  android:text="高一" android:textSize="@dimen/text_body"
                  android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                  android:focusable="true" android:clickable="true" />
              <Button android:id="@+id/grade10"
                  android:layout_width="0dp" android:layout_columnWeight="1"
                  android:layout_height="@dimen/btn_height" android:layout_margin="@dimen/btn_margin"
                  android:text="高二" android:textSize="@dimen/text_body"
                  android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                  android:focusable="true" android:clickable="true" />
              <Button android:id="@+id/grade11"
                  android:layout_width="0dp" android:layout_columnWeight="1"
                  android:layout_height="@dimen/btn_height" android:layout_margin="@dimen/btn_margin"
                  android:text="高三" android:textSize="@dimen/text_body"
                  android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                  android:focusable="true" android:clickable="true" />
          </GridLayout>

          <!-- 自定义题库（CSV 导入）与导出 -->
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="我的自定义题库（CSV 导入）"
              android:textColor="@color/text_secondary"
              android:textSize="@dimen/text_body"
              android:layout_marginBottom="@dimen/spacing_small" />

          <HorizontalScrollView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:scrollbars="none"
              android:layout_marginBottom="@dimen/spacing_small">

              <LinearLayout
                  android:id="@+id/customBankRow"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal" />
          </HorizontalScrollView>

          <GridLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:columnCount="2">
              <Button android:id="@+id/csvBtn0"
                  android:layout_width="0dp" android:layout_columnWeight="1"
                  android:layout_height="@dimen/btn_height" android:layout_margin="@dimen/btn_margin"
                  android:text="导入 CSV 题库" android:textSize="@dimen/text_body"
                  android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                  android:focusable="true" android:clickable="true" />
              <Button android:id="@+id/csvBtn1"
                  android:layout_width="0dp" android:layout_columnWeight="1"
                  android:layout_height="@dimen/btn_height" android:layout_margin="@dimen/btn_margin"
                  android:text="导出当前题库 CSV" android:textSize="@dimen/text_body"
                  android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                  android:focusable="true" android:clickable="true" />
          </GridLayout>


        <!-- 开机自启 -->
        <Button
            android:id="@+id/btnAutoStart"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:minWidth="300dp"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- 观看时长 -->
        <TextView
            android:id="@+id/tvWatchTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_small" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:layout_marginBottom="@dimen/spacing_medium">

            <Button android:id="@+id/btnTime30s"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:text="30秒"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnTime15"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:text="15分钟"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnTime30"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:text="30分钟"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnTime45"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:text="45分钟"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnTime60"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:text="60分钟"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnTime90"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:text="90分钟"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnTime120"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:text="120分钟"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
        </GridLayout>

        <!-- 解锁题数 -->
        <TextView
            android:id="@+id/tvUnlockCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_small" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:layout_marginBottom="@dimen/spacing_medium">

            <Button android:id="@+id/btnUnlock3"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:text="3题"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnUnlock5"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:text="5题"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
            <Button android:id="@+id/btnUnlock10"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin"
                android:text="10题"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true"
                android:clickable="true" />
        </GridLayout>

        <!-- 设置PIN -->
        <Button
            android:id="@+id/btnSetPin"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/spacing_medium"
            android:minWidth="300dp"
            android:text="@string/btn_set_pin"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- 说明文字 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="默认PIN码：1234"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:layout_marginTop="@dimen/spacing_large" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="计时开始后，到时自动锁屏\n重启电视后仍保持锁屏\n解锁需连续答对所选题库的题目"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:gravity="center"
            android:layout_marginTop="@dimen/spacing_small"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
